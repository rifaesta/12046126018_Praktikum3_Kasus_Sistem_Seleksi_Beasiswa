#include <stdio.h>
 
int main() {
	char nama[50];
	float ipk;
	long pendapatan;
 
    printf("=== SISTEM SELEKSI BEASISWA SI ===\n");
 
    printf("Masukkan Nama Mahasiswa: ");
	fgets(nama, 50, stdin);
 
    printf("Masukkan IPK: ");
    scanf("%f", &ipk);
 
    printf("Masukkan Pendapatan Orang Tua: Rp ");
    scanf("%ld", &pendapatan);
 
	printf("\n=== HASIL SELEKSI BEASISWA ===\n");
    printf("Nama   	: %s", nama);
    printf("IPK    	: %.2f\n", ipk);
    printf("Pendapatan : Rp %ld\n", pendapatan);
 
	if (ipk >= 3.50 && pendapatan < 3000000) {
        printf("Status 	: Beasiswa Penuh (100%%)\n");
	}
	else if (ipk >= 3.00 && pendapatan < 5000000) {
        printf("Status 	: Beasiswa 50%%\n");
	}
	else if (ipk >= 2.75 && pendapatan < 7000000) {
        printf("Status 	: Beasiswa 25%%\n");
	}
	else {
    	printf("Status 	: Tidak Mendapatkan Beasiswa\n");
	}
 
	return 0;
}
